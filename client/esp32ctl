#!/usr/bin/env bash
# esp32ctl — enqueue a command for the ESP32 board via relayd.
#
# Usage:
#   esp32ctl status             # ask firmware to log readiness
#   esp32ctl wol [aa:bb:..:ff]  # Wake-on-LAN magic packet
#                               # (default: firmware's CONFIG_RELAY_WOL_DEFAULT_MAC)
#
# Config (env or edit defaults below):
#   RELAYD_URL    default http://127.0.0.1:59777  (where relayd listens)
#   RELAYD_TOKEN_FILE  default /etc/relayd/token
set -euo pipefail

BASE="${RELAYD_URL:-http://127.0.0.1:59777}"
TOKEN_FILE="${RELAYD_TOKEN_FILE:-/etc/relayd/token}"

CMD="$(echo "${*:-status}" | tr '[:lower:]' '[:upper:]')"
TOKEN="$(cat "$TOKEN_FILE")"

curl -fsS -X POST "$BASE/cmd" \
  -H 'Content-Type: application/json' \
  --data "{\"token\":\"${TOKEN}\",\"cmd\":\"${CMD}\"}"
echo
